# ============================================
# Cassandra / Azure Cosmos DB Configuration
# ============================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env or .env.local
# 2. Replace the placeholder values with your actual credentials
# 3. Source the file: source .env (or add to your IDE environment variables)
#
# ⚠️ IMPORTANT: Never commit the actual .env file with real credentials!
# Add .env to your .gitignore

# Cassandra Contact Points (Azure Cosmos DB hostname)
# Example: your-account.cassandra.cosmos.azure.com
CASSANDRA_CONTACT_POINTS=20.57.131.26

# Cassandra Port
# - Local Cassandra: 9042
# - Azure Cosmos DB: Usually 10350 (check your connection string!)
CASSANDRA_PORT=9042

# Keyspace Name
CASSANDRA_KEYSPACE=community_keyspace

# Local Datacenter Name
# ⚠️ CRITICAL: This MUST match exactly with your Azure Cosmos DB datacenter
# Examples: "West US 2", "East US", "North Europe"
# To verify: Check Azure Portal → Cosmos DB → "Replicate data globally"
CASSANDRA_DATACENTER="West US 2"

# Authentication Credentials
# Get these from: Azure Portal → Cosmos DB → "Connection String" or "Keys"
CASSANDRA_USERNAME=your-cosmos-db-username
CASSANDRA_PASSWORD=your-cosmos-db-primary-key

# SSL Configuration
# Azure Cosmos DB REQUIRES SSL - set to true
# Local Cassandra: can be false
CASSANDRA_SSL=true

# ============================================
# Other Service Configuration (if needed)
# ============================================

# Kafka / Event Hubs
KAFKA_BOOTSTRAP_SERVERS=your-eventhub-namespace.servicebus.windows.net:9093
KAFKA_CONNECTION_STRING="Endpoint=sb://...;SharedAccessKeyName=...;SharedAccessKey=..."

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-minimum-256-bits

# Service Discovery (Eureka)
SERVICE_DISCOVERY_URL=http://localhost:8761/eureka/
HOSTNAME=localhost

# Application Port
PORT=8086

